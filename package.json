{
  "name": "cat-bluff-midnight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.22.0 <23" },
  "scripts": {
    "compile": "python3 scripts/compile.py",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.web.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "node node_modules/vitest/vitest.mjs run",
    "lint": "node node_modules/eslint/bin/eslint.js src/web scripts/copy-web-artifacts.mjs",
    "assets": "node scripts/copy-web-artifacts.mjs",
    "dev": "npm run assets && node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "npm run typecheck && npm run assets && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "demo:export": "node --experimental-strip-types src/export-demo-package.ts",
    "wallet:address": "node --experimental-strip-types src/wallet-address.ts",
    "deploy": "node --experimental-strip-types src/deploy.ts",
    "proof:up": "docker compose up -d",
    "proof:down": "docker compose down"
  },
  "dependencies": {
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "buffer": "6.0.3", "assert": "2.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "semver": "7.7.4",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@midnight-ntwrk/wallet-sdk-facade": "4.1.0",
    "pino": "10.3.1",
    "rxjs": "7.8.2",
    "ws": "8.20.0"
  },
  "overrides": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "typescript-eslint": "8.56.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "5.1.4",
    "vite": "7.3.1",
    "vite-plugin-wasm": "3.5.0",
    "vitest": "4.1.7",
    "jsdom": "27.4.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "22.19.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
